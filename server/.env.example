# 配置模板。复制成 .env 后填写：
#     Copy-Item server\.env.example server\.env
# .env 已被 .gitignore 忽略，里面可以放真实密钥；这个文件会进仓库，所以不放任何密钥。

# ---------------------------------------------------------------- 密码传输
# auto  : 看起来像 SM2 密文就解密，否则按明文处理（默认，两种都能登录）
# plain : 只收明文（靠 HTTPS 保护）
# sm2   : 只收密文，明文直接拒绝（正式环境建议改成这个）
PASSWORD_MODE=auto

# SM2 密钥对：私钥填这里，公钥填到 js/crypto.js 顶部的 PUBLIC_KEY，两边必须配对。
# 生成方式：python server/sm2.py keygen
# 不填也能跑：auto 模式下明文登录可用，只是前端发来的 SM2 密文解不开。
SM2_PRIVATE_KEY=

# ---------------------------------------------------------------- 短信通道
# log    : 不真正发送，验证码只打到控制台（默认，演示用）
# aliyun : 调用阿里云短信服务真正发送，下面四项必须填
# 开通步骤见 ALIYUN-SMS.md
SMS_PROVIDER=log

ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_TEMPLATE_PARAM=code
ALIYUN_SMS_REGION=cn-hangzhou

# ---------------------------------------------------------------- AI（SiliconFlow）
# 填了 Key 才会启用 /api/analyze 与 /api/tts；不填时两个接口返回 1017，
# 前端会自动回退到本地规则引擎和浏览器朗读。
SILICONFLOW_API_KEY=

AI_MODEL=deepseek-ai/DeepSeek-V3.2
AI_VL_MODEL=Qwen/Qwen3-VL-8B-Instruct
AI_EMBED_MODEL=Pro/BAAI/bge-m3
AI_RERANK_MODEL=Pro/BAAI/bge-reranker-v2-m3
AI_TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
AI_TTS_VOICE=FunAudioLLM/CosyVoice2-0.5B:alex

RAG_ENABLED=1
RAG_TOP_K=4

ANALYZE_PER_IP_PER_MIN=6
ANALYZE_MAX_TEXT=2000
TTS_PER_IP_PER_MIN=10
TTS_MAX_TEXT=500

# ---------------------------------------------------------------- 其他
# CODE_LOG=1
# CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:5173
# SESSION_COOKIE_SECURE=true
