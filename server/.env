# 后端本地配置。server/config.py 启动时自动读取本文件（不依赖 python-dotenv）。
# 已存在的环境变量优先，文件里的值不会覆盖它们。

# ---------------------------------------------------------------- 密码传输
# auto  : 看起来像 SM2 密文就解密，否则按明文处理（默认，两种都能登录）
# plain : 只收明文（靠 HTTPS 保护）
# sm2   : 只收密文，明文直接拒绝（正式环境建议改成这个）
PASSWORD_MODE=auto

# 演示密钥对：与 js/crypto.js 里的 PUBLIC_KEY 配对，两边必须同时替换。
# 换密钥：python sm2.py keygen，把输出分别填到 SM2_PRIVATE_KEY 和 js/crypto.js。
# 这是提交在仓库里的演示私钥，只用于课程演示，真实部署必须重新生成。
SM2_PRIVATE_KEY=74c105cc06576feba7f93894adaed6409a6b15a8b3e00f523b5f8cc8a6642b8c
SM2_PUBLIC_KEY=04ef6d3c38a8559e5e818c3fe15a9d09ea478ab1f4da150a891c40f98211b56f3363a3269366372796e71d7557bcf5762520029da5f0d23e0c7cb4f83cf071759d

# ---------------------------------------------------------------- 短信通道
# log    : 不真正发送，验证码只打到控制台（默认，演示用）
# aliyun : 调用阿里云短信服务真正发送，下面四项必须填
SMS_PROVIDER=log

# 阿里云 RAM 子账号的 AccessKey，不要用主账号的
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# 短信控制台里审核通过的签名名称，例如「银龄无诈」
ALIYUN_SMS_SIGN_NAME=

# 短信控制台里审核通过的模板 CODE，例如 SMS_123456789
ALIYUN_SMS_TEMPLATE_CODE=

# 模板里的变量名，模板写成「您的验证码为 ${code}」时这里就是 code
ALIYUN_SMS_TEMPLATE_PARAM=code
ALIYUN_SMS_REGION=cn-hangzhou

# ---------------------------------------------------------------- 其他
# 打印验证码到控制台（仅 SMS_PROVIDER=log 时生效）
# CODE_LOG=1
# 允许携带 Cookie 的前端来源，逗号分隔
# CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:5173
